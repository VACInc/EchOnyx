# EchOnyx Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# REQUIRED
# =============================================================================

# Hugging Face token for pyannote models (required for diarization)
# Get your token at: https://huggingface.co/settings/tokens
# Accept model agreements at:
#   - https://huggingface.co/pyannote/speaker-diarization-community-1
#   - https://huggingface.co/pyannote/segmentation-3.0
HF_TOKEN=

# =============================================================================
# DATABASE
# =============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=video_summarizer

# =============================================================================
# HARDWARE CONFIGURATION
# =============================================================================

# Hardware profile (auto-detected if not set)
# Options: strix_halo | rtx_5090 | multi_gpu | cpu_only
HARDWARE_PROFILE=

# GPU backend (auto-detected if not set)
# Options: cuda | vulkan | rocm | cpu
# Strix Halo should always resolve to rocm.
GPU_BACKEND=

# For NVIDIA multi-GPU setups
CUDA_VISIBLE_DEVICES=0

# For AMD Strix Halo
# HSA_OVERRIDE_GFX_VERSION=11.5.1
# GPU_MEMORY_FRACTION=0.75

# ROCm wheel source + versions (used by docker-compose.amd.yml)
ROCM_WHL_URL=https://repo.radeon.com/rocm/manylinux/rocm-rel-7.2/
ROCM_TORCH_VERSION=2.10.0+rocm7.2.0.lw.gitb6ee5fde
ROCM_TORCHAUDIO_VERSION=2.10.0+rocm7.2.0.git5047768f
ROCM_TORCHVISION_VERSION=0.25.0+rocm7.2.0.git82df5f59
ROCM_DEV_IMAGE=rocm/dev-ubuntu-24.04:7.2-complete
AMD_LLAMA_PACKAGE_URL=https://repo.radeon.com/rocm/llama.cpp/linux/rocm-rel-7.2/llama-b7782-ubuntu-24.04-rocm-7.2.0-gfx110X-gfx115X-gfx120X-x64.zip

# =============================================================================
# MODELS
# =============================================================================

# Transcription model
# Options: ibm-granite/granite-speech-3.3-8b | large-v3 | large-v3-turbo | medium | small
WHISPER_MODEL=large-v3

# Fallback to Whisper if Granite fails to load/transcribe
TRANSCRIPTION_FALLBACK_ENABLED=true
TRANSCRIPTION_FALLBACK_MODEL=large-v3

# Force Granite to run on CPU only (useful if ROCm kernels crash)
GRANITE_FORCE_CPU=false

# Diarization model
DIARIZATION_MODEL=pyannote/speaker-diarization-community-1

# Vision model (GGUF file in MODEL_CACHE_DIR)
VISION_MODEL=qwen3-omni-30b-a3b-q4_k_m.gguf

# Optional: Use an external OpenAI-compatible endpoint for vision (llama.cpp server)
# Example (host llama.cpp from Docker): http://host.docker.internal:8081/v1
VISION_ENDPOINT_URL=
VISION_ENDPOINT_MODEL=
VISION_ENDPOINT_API_KEY=
VISION_ENDPOINT_TIMEOUT_S=600
VISION_DEBUG=false

# Summarization model (GGUF file in MODEL_CACHE_DIR or model name for endpoint)
SUMMARIZATION_MODEL=qwen3-30b-a3b-q4_k_m.gguf

# Optional: Use an external OpenAI-compatible endpoint (llama.cpp server)
# Example (host llama.cpp from Docker): http://host.docker.internal:8080/v1
SUMMARIZATION_ENDPOINT_URL=
SUMMARIZATION_ENDPOINT_MODEL=
SUMMARIZATION_ENDPOINT_API_KEY=
SUMMARIZATION_ENDPOINT_TIMEOUT_S=600

# Embedding model
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B

# Audio event model (used for audio source hints)
AUDIO_EVENT_MODEL=MIT/ast-finetuned-audioset-10-10-0.4593
AUDIO_EVENT_SAMPLE_SECONDS=8
AUDIO_EVENT_NUM_SAMPLES=6
AUDIO_EVENT_MIN_SCORE=0.15
AUDIO_EVENT_DEBUG=false

# Job recovery (stale processing)
JOB_STALE_MINUTES=30

# Model loading strategy
# sequential: Load/unload models as needed (for memory-constrained systems)
# parallel: Keep all models loaded (for high-VRAM systems)
MODEL_LOADING=sequential

# =============================================================================
# PROCESSING
# =============================================================================

# Maximum video length in hours
MAX_VIDEO_LENGTH_HOURS=4

# Keyframe extraction interval in seconds
KEYFRAME_EXTRACTION_INTERVAL=5

# Visual context from frames (includes non-slide frames)
VISUAL_CONTEXT_MAX_FRAMES=60
VISUAL_CONTEXT_MAX_CHARS=8000

# Minimum speech duration for diarization
MIN_SPEECH_DURATION=0.5

# Concurrent batch jobs (increase for multi-GPU)
BATCH_CONCURRENT_JOBS=1

# Maximum upload size in GB
MAX_UPLOAD_SIZE_GB=10

# =============================================================================
# PATHS (Docker containers use these defaults)
# =============================================================================
# UPLOAD_DIR=/data/uploads
# MODEL_CACHE_DIR=/data/models
# CHROMA_PERSIST_DIR=/data/chroma
